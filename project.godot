; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="逐神"
config/description="Slay the Tower - tower defense roguelike"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.png"

[autoload]

RunConfig="*res://scripts/run_config.gd"
CardDB="*res://scripts/card_db.gd"
ContestantDB="*res://scripts/contestant_db.gd"
GameState="*res://scripts/game_state.gd"
EnemyDB="*res://scripts/enemy_db.gd"
StatusDB="*res://scripts/status_db.gd"
MapDB="*res://scripts/map_db.gd"
EventDB="*res://scripts/event_db.gd"
ShopDB="*res://scripts/shop_db.gd"
AudioManager="*res://scripts/audio_manager.gd"
RewardDB="*res://scripts/reward_db.gd"
Toast="*res://scripts/toast.gd"
DeckViewer="*res://scripts/deck_viewer.gd"
TraitDB="*res://scripts/trait_db.gd"
RemnantDB="*res://scripts/remnant_db.gd"
StoryDB="*res://scripts/story_db.gd"
NodeRuleDB="*res://scripts/node_rule_db.gd"
DialogueDB="*res://scripts/dialogue_db.gd"
Tutorial="*res://scripts/tutorial.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="res://assets/fonts/NotoSansSC-Regular.otf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.12, 1)
