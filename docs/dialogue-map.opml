<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>逐神 · 英雄对话分支</title>
  </head>
  <body>
      <outline text="逐神 · 英雄对话分支">
        <outline text="阿喀琉斯">
          <outline text="等待丈夫的新娘（已写）">
            <outline text="① t1 初见">
              <outline text="他看见你身上的什么痕迹"/>
              <outline text="「这位小姐好像也有着一段守望的过往」"/>
              <outline text="「我能看见你眼神中的思念。」"/>
            </outline>
            <outline text="② 三个回答">
              <outline text="「守望？」 → +1"/>
              <outline text="（不说话，一同守望） → +5"/>
              <outline text="「为什么？」 → +3"/>
            </outline>
            <outline text="③ t2 深入">
              <outline text="「呼~」"/>
              <outline text="「我们都为一个无法放下的人而背起了一段过去」"/>
              <outline text="「我的守望或许只是片刻休憩。」"/>
            </outline>
            <outline text="④ 分叉">
              <outline text="「那人是我的丈夫」 → +5 → t3a">
                <outline text="「"/>
                <outline text="「"/>
                <outline text="「"/>
                <outline text="回"/>
                <outline text="→"/>
              </outline>
              <outline text="「那人是你的爱人吗」 → +1 → t3b（待写）"/>
              <outline text="「那人是你的亲人吗」 → +2 → t3b（待写）"/>
            </outline>
            <outline text="⑤ t3b 荣耀线">
              <outline text="「唉——无妨」"/>
              <outline text="「曾经的我将荣耀视作生命」"/>
              <outline text="「而荣耀是危险的高台」"/>
              <outline text="「向荣耀与曾经发问？」 → +8"/>
              <outline text="「向他的挚友发问？」 → +10"/>
            </outline>
          </outline>
          <outline text="失明的守钟人（待写）">
            <outline text="① t1 初见：他看见你身上的什么痕迹？"/>
            <outline text="② 三个回答：顺着问 / 沉默 / 追问原因"/>
            <outline text="③ t2 深入：他把哪件事说给你听？"/>
            <outline text="④ 分叉：一条通向专属结局，两条通向通用追问"/>
            <outline text="⑤ 专属结局：好感 +15~20，附带回血 / 给牌 / 掉落"/>
          </outline>
