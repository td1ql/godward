# ============================================================
# DialogueDB —— 对话脚本数据
# ------------------------------------------------------------
# 说话人固定用：
#   "无上神音"  旁白/世界之声
#   "上帝"      陨落前的上帝
#   "教皇"      第二幕的真身
#   "影子"      教堂里的幻象
#   "你"        玩家
#
# 铁律：不出现「卡牌 / 牌组 / 抽牌 / 费用 / 能量」等游戏术语。
# ============================================================

extends Node

const LINES := {
	"prologue": [
		{"speaker": "无上神音", "text": "起初，光从众神的衣袍上落下。"},
		{"speaker": "无上神音", "text": "万物因他们而饱足，因他们而不朽。\n那时没有死，也没有夜。"},
		{"speaker": "无上神音", "text": "蛇从地底来。\n它不开口，只是看着。"},
		{"speaker": "无上神音", "text": "它看着世界树的根。\n看了很久。\n然后咬了下去。"},
		{"speaker": "无上神音", "text": "黑暗自地底涌出，浸透了根、枝、叶。\n众神尽遭污染，失去理智。"},
		{"speaker": "无上神音", "text": "上帝最后一个倒下。\n他倒下时，还在看着世界树。"},
		{"speaker": "无上神音", "text": "就在那时，一点光从世界之外落了下来。"},
		{"speaker": "无上神音", "text": "它落在上帝最后的思绪上。\n两样东西合在了一起。"},
		{"speaker": "上帝", "text": "「……你是什么？」"},
		{"speaker": "上帝", "text": "「不。你是我最后的念头。」"},
		{"speaker": "上帝", "text": "「听着。我已经不行了。」"},
		{"speaker": "上帝", "text": "「但你还活着。」"},
		{"speaker": "上帝", "text": "「往前走。别回头。」"},
		{"speaker": "上帝", "text": "「它们来了。别怕。」"},
		{"speaker": "无上神音", "text": "你抬起手。\n那不是你的手。"},
		{"speaker": "无上神音", "text": "有什么东西从灰里站了起来，慢慢转向你。"},
		{"speaker": "上帝", "text": "「打它。」"},
	],
	"prologue_after": [
		{"speaker": "上帝", "text": "「很好。」"},
		{"speaker": "上帝", "text": "「手会疼。那是好事。」"},
		{"speaker": "上帝", "text": "「你会死很多次。」"},
		{"speaker": "上帝", "text": "「没关系。你会醒过来。」"},
		{"speaker": "上帝", "text": "「直到你想起自己是谁。」"},
		{"speaker": "无上神音", "text": "然后，声音停了。"},
		{"speaker": "无上神音", "text": "你在灰里醒来。\n身上没有一处不疼。"},
		{"speaker": "无上神音", "text": "你不记得自己是谁。\n你只记得，你还想活着。"},
	],
	"first_divine": [
		{"speaker": "无上神音", "text": "门开了。"},
		{"speaker": "无上神音", "text": "里面不是神堂。\n是一片白，白得像还没被写上的地方。"},
		{"speaker": "无上神音", "text": "地面是软的。\n踩下去，会陷一点点。"},
		{"speaker": "无上神音", "text": "有东西在很远的地方呼吸。\n它一呼吸，地面就一起一伏。"},
	],
	"pope_before": [
		{"speaker": "无上神音", "text": "长廊尽头坐着一个老人，背对着你。"},
		{"speaker": "教皇", "text": "「这道门，从不为同一个人开两次。」"},
		{"speaker": "无上神音", "text": "他停了很久，才转过身来。"},
		{"speaker": "教皇", "text": "「你是谁？」"},
	],
	"pope_defeat": [
		{"speaker": "教皇", "text": "「原来是你。」"},
		{"speaker": "教皇", "text": "「你一直都在。」"},
		{"speaker": "教皇", "text": "「我以为……这里只有我一个人。」"},
		{"speaker": "无上神音", "text": "他闭上了眼睛。"},
	],
	"world_tree": [
		{"speaker": "无上神音", "text": "你抬头。"},
		{"speaker": "无上神音", "text": "天上有纹理。\n像纸被水泡过，又被谁晾干。"},
		{"speaker": "无上神音", "text": "有光落下来。\n你的影子比平时长得多。"},
	],
}

func get_lines(id: String) -> Array:
	return LINES.get(id, [])
